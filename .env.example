# PostgreSQL settings used by Docker Compose.
POSTGRES_USER=teco
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=teco
POSTGRES_PORT=5432

# Connection string for the server when it runs on your machine.
DATABASE_URL=postgresql://teco:change-this-local-password@localhost:5432/teco

# Server settings. JWT_SECRET must be replaced with a unique value before authentication is added.
PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Browser client setting.
VITE_API_URL=http://localhost:3000/api
