generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

/// User model
model User {
    id                       String                     @id @default(uuid())
    email                    String                     @unique
    name                     String
    passwordHash             String
    createdAt                DateTime                   @default(now())
    messages                 Message[]
    conversationParticipants Conversation_Participant[]
    sentFriendRequests       FriendRequest[]            @relation("SentFriendRequests")
    receivedFriendRequests   FriendRequest[]            @relation("ReceivedFriendRequests")
    friendshipsAsUserOne     Friendship[]               @relation("FriendshipsAsUserOne")
    friendshipsAsUserTwo     Friendship[]               @relation("FriendshipsAsUserTwo")
}

enum FriendRequestStatus {
    PENDING
    ACCEPTED
}

/// FriendRequest represents a pending or accepted request from one user to another.
model FriendRequest {
    id          String              @id @default(uuid())
    senderId    String
    recipientId String
    status      FriendRequestStatus @default(PENDING)
    createdAt   DateTime            @default(now())
    updatedAt   DateTime            @updatedAt
    respondedAt DateTime?

    sender    User @relation("SentFriendRequests", fields: [senderId], references: [id])
    recipient User @relation("ReceivedFriendRequests", fields: [recipientId], references: [id])

    @@unique([senderId, recipientId])
    @@index([recipientId, status, createdAt])
    @@index([senderId, status])
}

/// Friendship is a symmetric, accepted relationship stored in canonical user-ID order.
model Friendship {
    userOneId String
    userTwoId String
    createdAt DateTime @default(now())

    userOne User @relation("FriendshipsAsUserOne", fields: [userOneId], references: [id])
    userTwo User @relation("FriendshipsAsUserTwo", fields: [userTwoId], references: [id])

    @@id([userOneId, userTwoId])
    @@index([userOneId])
    @@index([userTwoId])
}

/// Message model
model Message {
    id             String       @id @default(uuid())
    content        String
    createdAt      DateTime     @default(now())
    createdBy      User         @relation(fields: [createdById], references: [id])
    createdById    String
    conversation   Conversation @relation(fields: [conversationId], references: [id])
    conversationId String

    // “show me all conversations for this user”
    @@index([conversationId, createdAt])
}

/// Conversation model
model Conversation {
    id                       String                     @id @default(uuid())
    createdAt                DateTime                   @default(now())
    updatedAt                DateTime                   @updatedAt
    messages                 Message[]
    conversationParticipants Conversation_Participant[]
}

/// Conversation_Participant model
model Conversation_Participant {
    conversationId String
    userId         String

    conversation Conversation @relation(fields: [conversationId], references: [id])
    user         User         @relation(fields: [userId], references: [id])

    @@id([conversationId, userId])
    // “show me messages for this conversation ordered by time”
    @@index([userId])
}
