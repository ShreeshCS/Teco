{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"], // Only compile app execution code
  "exclude": ["node_modules", "prisma.config.ts"] // prisma client generation will handle the prisma.config.ts file, so we exclude it from compilation
}
